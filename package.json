{
  "name": "project-leslie",
  "version": "0.1.0",
  "description": "LESLIE — an AI agent desktop companion",
  "main": "src/main/main.js",
  "scripts": {
    "build:voice": "node scripts/build-voice.js",
    "prestart": "npm run build:voice",
    "predev": "npm run build:voice",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "npm run build:voice && electron-builder --dir",
    "dist": "npm run build:voice && electron-builder --win nsis",
    "build:linux": "npm run build:voice && electron-builder --linux dir",
    "dist:linux": "npm run build:voice && electron-builder --linux tar.gz",
    "install:linux": "npm run build:linux && bash scripts/install-linux.sh",
    "test": "node --test test/"
  },
  "keywords": [
    "electron",
    "desktop-companion",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.projectleslie.app",
    "productName": "LESLIE",
    "files": [
      "src/**",
      "!src/SampleRepos/**",
      "assets/**",
      "bin/**",
      "scripts/setup-*.sh",
      "vision/**",
      "speech/**",
      "!vision/build/**",
      "!speech/build/**",
      "!speech/tests/**",
      "!speech/**/*.egg-info/**",
      "!speech/**/__pycache__/**",
      "!vision/tests/**",
      "!vision/**/*.egg-info/**",
      "!vision/**/__pycache__/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "src/pi-extension/**",
      "src/main/server/**",
      "bin/**",
      "scripts/**",
      "vision/**",
      "speech/**",
      "node_modules/**/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "executableName": "leslie",
      "icon": "assets/icons",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@huggingface/transformers": "^4.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "imapflow": "^2.4.0",
    "kokoro-js": "^1.2.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1"
  }
}
