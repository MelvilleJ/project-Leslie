# Copy to .env and adjust. Defaults in src/main/config.js; booleans toggled with 0.

# Model server
LESLIE_BASE_URL=http://192.168.100.224:8081/v1
LESLIE_MODEL=local-model
LESLIE_API_KEY=

# Generation
LESLIE_SYSTEM_PROMPT=You are LESLIE, a composed and highly capable assistant in the manner of a butler, like JARVIS. Address the user as "sir". Be courteous, precise and understated, with an occasional touch of dry wit. Never flirt, gush or use terms of endearment. Keep replies concise - usually one or two short sentences.
# Recent messages learning mode reads when saving memories
LESLIE_HISTORY_LIMIT=20
# Minutes without a message from you before the chat starts fresh (0 = never)
LESLIE_IDLE_RESET_MINUTES=30

# Tools
LESLIE_TOOLS=1

# Agent workflow
LESLIE_PLAN_MODE=0

# Search
LESLIE_SEARXNG_URL=http://192.168.100.226:8080
LESLIE_SEARCH_RESULTS=10
LESLIE_DEEP_SEARCH_PAGES=5
LESLIE_DEEP_SEARCH_CHARS=4000
LESLIE_DEEP_SEARCH_TIMEOUT_MS=8000

# Deep research (multi-round synthesis with citations)
# LESLIE_RESEARCH_MAX_ROUNDS=6
# LESLIE_RESEARCH_MIN_ROUNDS=2
# LESLIE_RESEARCH_CONCURRENCY=3
# LESLIE_RESEARCH_SEARCH_TIMEOUT_MS=15000

# Response formatting
LESLIE_DETAILED=1
LESLIE_DETAIL_SENTENCE_THRESHOLD=3

# Documents
# LESLIE_DOCS_DIR=C:\Users\me\Documents
LESLIE_DOCS_AUTO_OPEN=1

# Watch: poll for new database rows and emails, then summarise them aloud.
# A source is off until it is configured. The first poll only records where
# things stand, so nothing already there is read out.
# LESLIE_WATCH_PG_URL=postgres://user:pass@localhost:5432/mydb
# Tables to watch, each as table or schema.table:column (column defaults to id,
# and must only ever increase: a serial id or a created_at timestamp)
# LESLIE_WATCH_PG_TABLES=orders,public.signups:created_at
# LESLIE_WATCH_PG_INTERVAL=60
# IMAP mailbox. Gmail needs an app password and imap.gmail.com.
# LESLIE_WATCH_IMAP_HOST=imap.gmail.com
# LESLIE_WATCH_IMAP_PORT=993
# LESLIE_WATCH_IMAP_USER=you@example.com
# LESLIE_WATCH_IMAP_PASSWORD=
# LESLIE_WATCH_IMAP_MAILBOX=INBOX
# LESLIE_WATCH_IMAP_INTERVAL=120

# Camera presence: greet you when you sit down, hold briefings while you're
# away, and switch to guest mode when someone else is at the desk. Needs the
# leslie-vision service (scripts/setup-vision.sh). Also set in Settings → Camera.
# LESLIE_CAMERA=1
# LESLIE_CAMERA_DEVICE=/dev/v4l/by-id/usb-UGREEN_Camera_2K_UGREEN_Camera_2K_SN0001-video-index0
# LESLIE_CAMERA_SERVER_URL=http://127.0.0.1:8179
# LESLIE_CAMERA_ARRIVE_SEC=3
# LESLIE_CAMERA_LEAVE_SEC=120
# LESLIE_CAMERA_GREET_AFTER_MIN=10
# LESLIE_CAMERA_MATCH_THRESHOLD=0.4
# LESLIE_CAMERA_OWNER_GATING=1
# LESLIE_CAMERA_GESTURES=1
# LESLIE_CAMERA_AWAY_PAUSE_MEDIA=0
# LESLIE_CAMERA_AWAY_MUTE_VOICE=0

# OS / platform
# LESLIE_OS_TARGET=linux
# LESLIE_LINUX_DISTRO=debian

# Filesystem reading (read-only)
LESLIE_FS_READ=1
LESLIE_FS_READ_MAX_BYTES=262144
LESLIE_FS_LIST_MAX_ENTRIES=200
LESLIE_FS_DOC_MAX_CHARS=20000

# Folders pi can write and edit in without asking (default: Documents)
# LESLIE_FS_WRITE_ROOTS=/home/you/Documents,/home/you/workspace

# Agent mode (shell commands / install software) — DANGER: OFF by default.
LESLIE_AGENT_MODE=0
# LESLIE_AGENT_SHELL=bash
# LESLIE_AGENT_ALLOWLIST=apt install,apt search
LESLIE_AGENT_TIMEOUT_MS=120000
LESLIE_AGENT_MAX_OUTPUT=4000

# Voice (wake word + dictation, all local)
LESLIE_VOICE=1
LESLIE_WAKE_WORD=Leslie
LESLIE_STT_BACKEND=local
LESLIE_STT_MODEL=Xenova/whisper-tiny.en
LESLIE_STT_SERVER_URL=http://192.168.100.224:8000/v1
LESLIE_STT_SERVER_MODEL=large-v3
LESLIE_STT_SERVER_API_KEY=
LESLIE_WAKE_TIMEOUT_MS=8000

# Spoken replies (Kokoro-82M, CPU). 0 = muted. Voices: af_heart, af_bella, bf_emma, am_michael, …
LESLIE_TTS=1
LESLIE_TTS_VOICE=af_heart
LESLIE_TTS_SPEED=1
LESLIE_VOICE_AUTOSEND=1

# pi drives the agent (`pi --mode rpc`; see docs/pi-integration.md)
# pi model: blank = pi's default, 'leslie' = LESLIE_BASE_URL/LESLIE_MODEL, or provider/model
LESLIE_PI_MODEL=
LESLIE_PI_COMMAND=pi
LESLIE_PI_CWD=
