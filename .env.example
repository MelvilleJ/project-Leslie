# LESLIE configuration — copy to ".env" and adjust.
# Every value has a sensible default (see src/main/config.js); override only
# what you need. Booleans are toggled with "0" to disable.

# --- Model server ------------------------------------------------------------
# Base URL of an OpenAI-compatible /v1/chat/completions server, INCLUDING /v1.
# llama-server default port is 8080; LM Studio 1234; Ollama 11434.
LESLIE_BASE_URL=http://192.168.100.224:8081/v1

# Model name. llama.cpp/LM Studio ignore this; vLLM/Ollama need the real id.
LESLIE_MODEL=local-model

# Most local servers need no key. Leave empty to omit the Authorization header.
LESLIE_API_KEY=

# --- Generation --------------------------------------------------------------
# Persona prompt (kept short — replies show in a small speech bubble).
LESLIE_SYSTEM_PROMPT=You are LESLIE, a friendly desktop companion. Reply in a warm, concise, conversational way - usually one or two short sentences.

LESLIE_TEMPERATURE=0.7
LESLIE_MAX_TOKENS=8000

# How many past messages (user+assistant) to keep as context.
LESLIE_HISTORY_LIMIT=20

# --- Tools -------------------------------------------------------------------
# Master switch for tool-calling (web search, …). Set to 0 to disable.
LESLIE_TOOLS=1
# Max tool round-trips per message before forcing a final answer.
LESLIE_MAX_TOOL_CALLS=5

# --- Agent workflow (Odysseus-style layers) ---------------------------------
# Plan mode: investigate with read-only tools only, then propose a plan instead
# of executing (effectful tools are hidden + rejected while on). 1 to enable.
LESLIE_PLAN_MODE=0
# Tool RAG: advertise only the relevant tools per request. 0 sends all tools.
LESLIE_TOOL_RAG=1
# Use local embeddings (transformers.js) for tool selection (downloads a small
# model on first use; falls back to keywords on error). 1 to enable.
LESLIE_TOOL_RAG_EMBEDDINGS=0
LESLIE_TOOL_RAG_TOPK=4
LESLIE_TOOL_RAG_MODEL=Xenova/all-MiniLM-L6-v2
# Reliability guards for weak local models.
LESLIE_LOOP_STUCK_ROUNDS=4
LESLIE_LOOP_RUNAWAY_LIMIT=15
LESLIE_MAX_INTENT_NUDGES=2

# SearXNG instance backing the web_search tool (JSON output must be enabled).
LESLIE_SEARXNG_URL=http://192.168.100.226:8080
# How many search results to feed back to the model.
LESLIE_SEARCH_RESULTS=10

# deep_search reads the full text of top result pages.
LESLIE_DEEP_SEARCH_PAGES=5
LESLIE_DEEP_SEARCH_CHARS=4000
LESLIE_DEEP_SEARCH_TIMEOUT_MS=8000

# Short summary + optional details; long answers open the detail window.
# Set to 0 to disable.
LESLIE_DETAILED=1
# Any answer longer than this many sentences is moved from the speech bubble into
# the details window (a short teaser stays in the bubble). Default 3.
LESLIE_DETAIL_SENTENCE_THRESHOLD=3

# --- Documents (create_document tool) ---------------------------------------
# Folder where created documents (docx/pdf/xlsx/txt/md/html/csv) are saved.
# Defaults to the user's Documents folder.
# LESLIE_DOCS_DIR=C:\Users\me\Documents
# Open a document in its default app after creating it. Set to 0 to disable.
LESLIE_DOCS_AUTO_OPEN=1

# --- OS / platform -----------------------------------------------------------
# Target OS: "windows" (default) or "linux". Auto-detected from the running
# platform if not set. Also configurable in Settings → Behaviour.
# LESLIE_OS_TARGET=linux
# Linux distro: "debian" (apt), "fedora" (dnf), or "arch" (pacman). Default: debian.
# LESLIE_LINUX_DISTRO=debian

# --- Agent mode (run system commands / install software) ---------------------
# DANGER: lets LESLIE execute shell commands on this machine. OFF by default.
# Set to 1 to enable. Non-allowlisted commands always require an Approve click.
LESLIE_AGENT_MODE=0
# Shell override (leave unset to auto-detect: bash on Linux, powershell on Windows).
# LESLIE_AGENT_SHELL=bash
# Allowlist override (leave unset to use the default list for the detected OS/distro).
# LESLIE_AGENT_ALLOWLIST=apt install,apt search
# Per-command timeout (ms) and max characters of output returned to the model.
LESLIE_AGENT_TIMEOUT_MS=120000
LESLIE_AGENT_MAX_OUTPUT=4000

# --- Voice (wake word + dictation, all local) --------------------------------
# Set to 0 to disable the whole voice pipeline.
LESLIE_VOICE=1
# Wake phrase; matching is fuzzy and keys on the last word ("leslie").
LESLIE_WAKE_WORD=Leslie
# Speech-to-text backend: "local" (in-process, transformers.js) or "server"
# (offload to an external whisper server). Default: local.
LESLIE_STT_BACKEND=local
# transformers.js Whisper model (downloaded once from HF, then cached).
# Used only when LESLIE_STT_BACKEND=local.
LESLIE_STT_MODEL=Xenova/whisper-tiny.en
# Whisper server (used only when LESLIE_STT_BACKEND=server). Any OpenAI-compatible
# /audio/transcriptions endpoint: whisper.cpp's whisper-server, faster-whisper-
# server, speaches, LocalAI, OpenAI, … Give the base URL INCLUDING /v1.
LESLIE_STT_SERVER_URL=http://192.168.100.224:8000/v1
# Model id the server should use (most local whisper servers ignore this).
LESLIE_STT_SERVER_MODEL=large-v3
# Optional bearer token; leave empty to omit the Authorization header.
LESLIE_STT_SERVER_API_KEY=
# After the wake word, how long (ms) to listen for the spoken command.
LESLIE_WAKE_TIMEOUT_MS=8000
# Auto-send dictated text (vs leaving it in the input to edit). Set to 0 to disable.
LESLIE_VOICE_AUTOSEND=1
